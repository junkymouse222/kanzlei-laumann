# Pflicht: muss identisch zu TRACKING_API_KEY der Kanzlei-App sein
TRACKING_API_KEY=changeme-langer-zufaelliger-key

# Bind-Adresse/Port des Node-Prozesses (hinter nginx)
HOST=127.0.0.1
PORT=8787

# Basis-URL für die an Kunden ausgegebenen tracking_url-Links.
# Der Kanzlei-Client normalisiert ohnehin auf spedition-hausmann.de.
PUBLIC_BASE_URL=https://spedition-hausmann.de

# Ablageort der JSON-Persistenz
DATA_DIR=/opt/spedition-hausmann/data

# Passwort für /admin (Disposition). Nicht das TRACKING_API_KEY.
ADMIN_PASSWORD=langes-eigenes-passwort
